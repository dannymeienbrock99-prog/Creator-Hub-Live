<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#B83B1B55" />
            <corners android:radius="17dp" />
            <stroke android:width="2dp" android:color="#F43F5E" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#AA111827" />
            <corners android:radius="17dp" />
            <stroke android:width="1dp" android:color="#88A855F7" />
        </shape>
    </item>
</selector>
