<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Creator Hub Voice Studio"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chatStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Lokales Sprachstudio · keine API und kein externer Dienst"
            android:textColor="#94A3B8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Vorlesen und Stimme"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/ttsEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Vorlesefunktion aktiv"
            android:textColor="#FFFFFF" />

        <Spinner
            android:id="@+id/voiceSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Spinner
            android:id="@+id/filterSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Geschwindigkeit" android:textColor="#FFFFFF" />
        <SeekBar android:id="@+id/speedBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="100" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tonhöhe" android:textColor="#FFFFFF" />
        <SeekBar android:id="@+id/pitchBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="100" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lautstärke" android:textColor="#FFFFFF" />
        <SeekBar android:id="@+id/ttsVolume" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="100" />

        <EditText
            android:id="@+id/allowedUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Optional: Namen für spätere Rollenfilter"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Stimme testen" />

        <LinearLayout
            android:id="@+id/chatMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/saveChatSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Voice-Einstellungen speichern" />
    </LinearLayout>
</ScrollView>