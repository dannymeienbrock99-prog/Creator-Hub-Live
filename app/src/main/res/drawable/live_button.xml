<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="0" android:startColor="#6D28D9" android:endColor="#0891B2" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#8B5CF6" android:centerColor="#7C3AED" android:endColor="#06B6D4" />
            <corners android:radius="17dp" />
            <stroke android:width="1dp" android:color="#77FFFFFF" />
        </shape>
    </item>
</selector>
